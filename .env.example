# Copy to .env.local for development, and set the same variables in the host's environment
# (Vercel: Project → Settings → Environment Variables). Never commit the real values.

# The shared MongoDB database. The VEKAT site uses the SAME connection string, so one person
# registering on both sites has one record and one reference.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=homebridge

# Password for /admin. Anyone with it can read every member's personal details and ID number,
# so make it long and random, and share it only with the officers who need it.
ADMIN_PASSWORD=

# Signs members' sign-in cookies. Set it to a long random string; changing it signs every
# member out. Registration refuses to run without it.
MEMBER_SESSION_SECRET=

# Optional: signs the admin session cookie. If unset, ADMIN_PASSWORD is used — which means
# changing the password signs everyone out. Set it to a separate random string in production.
ADMIN_SESSION_SECRET=

# Email, for the confirmation an applicant gets after submitting the registration form.
# Sent through Resend. Without RESEND_API_KEY no confirmation email is sent and applications
# still save normally. The VEKAT site uses the same Resend account.
RESEND_API_KEY=

# Leave EMAIL_FROM empty until a domain is verified in Resend: empty means Resend's test sender,
# which can ONLY deliver to the address that owns the Resend account.
# Once vekat.org is verified: EMAIL_FROM="HomeBridge Cooperative <no-reply@vekat.org>"
EMAIL_FROM=

# Where replies go. A no-reply address has no mailbox behind it, so point this at one that does.
EMAIL_REPLY_TO=info@homebridgecooperative.org

# Optional: a blind copy of every confirmation, so the office has a record.
EMAIL_BCC=
